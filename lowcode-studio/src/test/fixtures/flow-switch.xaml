<?xml version="1.0" encoding="utf-8"?>
<Activity mc:Ignorable="sap sap2010"
  xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
  xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Class="FlowSwitchDemo">
  <Flowchart DisplayName="FlowSwitchDemo">
    <Flowchart.StartNode>
      <FlowStep x:Name="start">
        <FlowStep.Action>
          <Sequence DisplayName="Start" />
        </FlowStep.Action>
        <FlowStep.Next>
          <FlowSwitch x:TypeArguments="x:String" Expression="[key]" DisplayName="Route" x:Name="sw">
            <x:Reference>end</x:Reference>
          </FlowSwitch>
        </FlowStep.Next>
      </FlowStep>
    </Flowchart.StartNode>
    <x:Reference>sw</x:Reference>
    <FlowStep x:Name="end">
      <FlowStep.Action>
        <Sequence DisplayName="End" />
      </FlowStep.Action>
    </FlowStep>
  </Flowchart>
</Activity>
