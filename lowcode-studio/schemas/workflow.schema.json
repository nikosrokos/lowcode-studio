{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LowCode Studio Workflow",
  "type": "object",
  "required": ["schemaVersion", "name", "type", "activities"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": ["Sequence", "Flowchart"]
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["String", "Int32", "Boolean", "Double", "Object", "DataTable", "Array"]
          },
          "defaultValue": {},
          "scope": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "arguments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "direction"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" },
          "direction": {
            "type": "string",
            "enum": ["In", "Out", "InOut"]
          },
          "defaultValue": {}
        }
      }
    },
    "activities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "displayName"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "displayName": { "type": "string" },
          "properties": { "type": "object" },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "color": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
          },
          "children": {
            "type": "array",
            "items": { "$ref": "#/properties/activities/items" }
          },
          "elseChildren": {
            "type": "array",
            "items": { "$ref": "#/properties/activities/items" }
          }
        }
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "from", "to"],
        "properties": {
          "id": { "type": "string" },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "label": { "type": "string" }
        }
      }
    },
    "startActivityId": { "type": "string" },
    "metadata": {
      "type": "object",
      "properties": {
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "author": { "type": "string" },
        "template": { "type": "string" }
      }
    }
  }
}
