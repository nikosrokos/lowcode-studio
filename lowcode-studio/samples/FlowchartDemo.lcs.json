      },
      "x": 80,
      "y": 360
    },
    {
      "id": "log_low",
      "type": "System.LogMessage",
      "displayName": "Low Amount",
      "properties": {
        "message": "\"Low value path\"",
        "level": "Info"
      },
      "x": 420,
      "y": 360
    },
    {
      "id": "end_1",
      "type": "Flowchart.End",
      "displayName": "End",
      "properties": {},
      "x": 280,
      "y": 520
    }
  ],
  "connections": [
    { "id": "c1", "from": "start_1", "to": "dec_1", "label": "" },
    { "id": "c2", "from": "dec_1", "to": "log_high", "label": "True" },
    { "id": "c3", "from": "dec_1", "to": "log_low", "label": "False" },
    { "id": "c4", "from": "log_high", "to": "end_1", "label": "" },
    { "id": "c5", "from": "log_low", "to": "end_1", "label": "" }
  ],
