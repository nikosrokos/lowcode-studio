{
  "schemaVersion": "1.0",
  "name": "FlowchartDemo",
  "description": "Sample flowchart with decision and links",
  "type": "Flowchart",
  "startActivityId": "start_1",
  "variables": [
    {
      "name": "amount",
      "type": "Int32",
      "defaultValue": 120
    }
  ],
  "arguments": [],
  "activities": [
    {
      "id": "start_1",
      "type": "Flowchart.Start",
      "displayName": "Start",
      "properties": {},
      "x": 280,
      "y": 40
    },
    {
      "id": "dec_1",
      "type": "Flowchart.FlowDecision",
      "displayName": "Amount > 100?",
      "properties": {
        "condition": "amount > 100"
      },
      "x": 250,
      "y": 160
    },
    {
      "id": "log_high",
      "type": "System.LogMessage",
