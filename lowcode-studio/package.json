{
  "name": "lowcode-studio",
  "displayName": "LowCode Studio",
  "description": "Mac-first low-code RPA for VS Code/Cursor: REFramework design, scenario dry-runs (Shift+F5), and the easiest Connect to Studio Web handoff for Orchestrator publish.",
  "version": "0.6.3",
  "publisher": "lowcode-studio",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "rpa",
    "low-code",
    "automation",
    "studio",
    "workflow",
    "uipath",
    "reframework",
    "flowchart",
    "mac"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "icon": "media/icon.png",
  "contributes": {
    "customEditors": [
      {
        "viewType": "lowcodeStudio.workflowEditor",
        "displayName": "LowCode Studio Designer",
        "selector": [
          {
            "filenamePattern": "*.lcs.json"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lowcodeStudio",
          "title": "LowCode Studio",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "lowcodeStudio": [
        {
          "id": "lowcodeStudio.projects",
          "name": "Project Explorer"
        },
        {
          "id": "lowcodeStudio.activities",
          "name": "Activities"
        },
        {
          "id": "lowcodeStudio.variables",
          "name": "Variables"
        }
      ]
    },
    "commands": [
      {
        "command": "lowcodeStudio.openLocalProject",
        "title": "LowCode Studio: Open Local Project",
        "icon": "$(folder-opened)"
      },
      {
        "command": "lowcodeStudio.newProject",
        "title": "LowCode Studio: New Project",
        "icon": "$(new-folder)"
      },
      {
        "command": "lowcodeStudio.newREFramework",
        "title": "LowCode Studio: New REFramework Project",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "lowcodeStudio.newWorkflow",
        "title": "LowCode Studio: New Workflow",
        "icon": "$(new-file)"
      },
      {
        "command": "lowcodeStudio.openDesigner",
        "title": "LowCode Studio: Open Designer"
      },
      {
        "command": "lowcodeStudio.validatePackages",
        "title": "LowCode Studio: Validate Packages",
        "icon": "$(warning)"
      },
      {
        "command": "lowcodeStudio.validateWorkflow",
        "title": "LowCode Studio: Validate Workflow",
        "icon": "$(check)"
      },
      {
        "command": "lowcodeStudio.dryRun",
        "title": "LowCode Studio: Dry Run",
        "icon": "$(play)"
      },
      {
        "command": "lowcodeStudio.dryRunScenario",
        "title": "LowCode Studio: Dry Run Scenarios",
        "icon": "$(beaker)"
      },
      {
        "command": "lowcodeStudio.manageScenarios",
        "title": "LowCode Studio: Manage Scenarios",
        "icon": "$(checklist)"
      },
      {
        "command": "lowcodeStudio.registerCustomActivity",
        "title": "LowCode Studio: Register Custom Activity",
        "icon": "$(extensions)"
      },
      {
        "command": "lowcodeStudio.manageCustomActivities",
        "title": "LowCode Studio: Manage Custom Activities"
      },
      {
        "command": "lowcodeStudio.addVariable",
        "title": "LowCode Studio: Add Variable",
        "icon": "$(add)"
      },
      {
        "command": "lowcodeStudio.refreshExplorer",
        "title": "LowCode Studio: Refresh Explorer",
        "icon": "$(refresh)"
      },
      {
        "command": "lowcodeStudio.insertActivity",
        "title": "LowCode Studio: Insert Activity"
      },
      {
        "command": "lowcodeStudio.exportPseudocode",
        "title": "LowCode Studio: Export Pseudocode"
      },
      {
        "command": "lowcodeStudio.importUiPathProject",
        "title": "LowCode Studio: Import UiPath Project Folder",
        "icon": "$(folder-opened)"
      },
      {
        "command": "lowcodeStudio.importUiPathPackage",
        "title": "LowCode Studio: Import UiPath Package (.nupkg)",
        "icon": "$(file-zip)"
      },
      {
        "command": "lowcodeStudio.connectStudioWeb",
        "title": "LowCode Studio: Connect to Studio Web",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "lowcodeStudio.exportStudioWeb",
        "title": "LowCode Studio: Export for Studio Web",
        "icon": "$(export)"
      },
      {
        "command": "lowcodeStudio.showStudioWebGuide",
        "title": "LowCode Studio: Show Studio Web Guide"
      },
      {
        "command": "lowcodeStudio.exportConfigXlsx",
        "title": "LowCode Studio: Export Config.xlsx",
        "icon": "$(file-binary)"
      },
      {
        "command": "lowcodeStudio.importConfigXlsx",
        "title": "LowCode Studio: Import Config.xlsx",
        "icon": "$(file)"
      },
      {
        "command": "lowcodeStudio.openStudioWeb",
        "title": "LowCode Studio: Open Studio Web"
      },
      {
        "command": "lowcodeStudio.showGettingStarted",
        "title": "LowCode Studio: Getting Started"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "lowcodeStudio.openLocalProject",
          "when": "view == lowcodeStudio.projects",
          "group": "navigation@0"
        },
        {
          "command": "lowcodeStudio.dryRunScenario",
          "when": "view == lowcodeStudio.projects",
          "group": "navigation@1"
        },
        {
          "command": "lowcodeStudio.manageScenarios",
          "when": "view == lowcodeStudio.projects",
          "group": "navigation@2"
        },
        {
          "command": "lowcodeStudio.connectStudioWeb",
          "when": "view == lowcodeStudio.projects",
          "group": "navigation@3"
        },
        {
          "command": "lowcodeStudio.validatePackages",
          "when": "view == lowcodeStudio.projects",
          "group": "navigation@4"
        },
        {
          "command": "lowcodeStudio.refreshExplorer",
          "when": "view == lowcodeStudio.projects",
          "group": "navigation@5"
        },
        {
          "command": "lowcodeStudio.newREFramework",
          "when": "view == lowcodeStudio.projects",
          "group": "1_create@1"
        },
        {
          "command": "lowcodeStudio.newProject",
          "when": "view == lowcodeStudio.projects",
          "group": "1_create@2"
        },
        {
          "command": "lowcodeStudio.newWorkflow",
          "when": "view == lowcodeStudio.projects",
          "group": "1_create@3"
        },
        {
          "command": "lowcodeStudio.importUiPathProject",
          "when": "view == lowcodeStudio.projects",
          "group": "2_import@1"
        },
        {
          "command": "lowcodeStudio.importUiPathPackage",
          "when": "view == lowcodeStudio.projects",
          "group": "2_import@2"
        },
        {
          "command": "lowcodeStudio.exportStudioWeb",
          "when": "view == lowcodeStudio.projects",
          "group": "3_export@1"
        },
        {
          "command": "lowcodeStudio.exportConfigXlsx",
          "when": "view == lowcodeStudio.projects",
          "group": "3_export@2"
        },
        {
          "command": "lowcodeStudio.importConfigXlsx",
          "when": "view == lowcodeStudio.projects",
          "group": "3_export@3"
        },
        {
          "command": "lowcodeStudio.addVariable",
          "when": "view == lowcodeStudio.variables",
          "group": "navigation"
        },
        {
          "command": "lowcodeStudio.registerCustomActivity",
          "when": "view == lowcodeStudio.activities",
          "group": "navigation"
        },
        {
          "command": "lowcodeStudio.manageCustomActivities",
          "when": "view == lowcodeStudio.activities",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "lowcodeStudio.insertActivity",
          "when": "view == lowcodeStudio.activities && viewItem == activity",
          "group": "inline"
        }
      ],
      "editor/title": [
        {
          "command": "lowcodeStudio.validatePackages",
          "when": "resourceFilename =~ /\\.lcs\\.json$/",
          "group": "navigation"
        },
        {
          "command": "lowcodeStudio.validateWorkflow",
          "when": "resourceFilename =~ /\\.lcs\\.json$/",
          "group": "navigation"
        },
        {
          "command": "lowcodeStudio.dryRun",
          "when": "resourceFilename =~ /\\.lcs\\.json$/",
          "group": "navigation"
        },
        {
          "command": "lowcodeStudio.dryRunScenario",
          "when": "resourceFilename =~ /\\.lcs\\.json$/",
          "group": "navigation"
        },
        {
          "command": "lowcodeStudio.connectStudioWeb",
          "when": "resourceFilename =~ /\\.lcs\\.json$/",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "lowcodeStudio.insertActivity",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "lowcodeStudio.newWorkflow",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      },
      {
        "command": "lowcodeStudio.dryRun",
        "key": "f5",
        "when": "resourceFilename =~ /\\.lcs\\.json$/"
      },
      {
        "command": "lowcodeStudio.dryRunScenario",
        "key": "shift+f5",
        "when": "resourceFilename =~ /\\.lcs\\.json$/"
      },
      {
        "command": "lowcodeStudio.manageScenarios",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t"
      },
      {
        "command": "lowcodeStudio.connectStudioWeb",
        "key": "ctrl+shift+u",
        "mac": "cmd+shift+u"
      },
      {
        "command": "lowcodeStudio.validateWorkflow",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "resourceFilename =~ /\\.lcs\\.json$/"
      }
    ],
    "languages": [
      {
        "id": "lowcode-studio",
        "aliases": [
          "LowCode Studio Workflow",
          "lcs"
        ],
        "extensions": [
          ".lcs.json"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "*.lcs.json",
        "url": "./schemas/workflow.schema.json"
      }
    ],
    "configuration": {
      "title": "LowCode Studio",
      "properties": {
        "lowcodeStudio.uipathTargetFramework": {
          "type": "string",
          "default": "Windows",
          "enum": [
            "Windows",
            "Portable"
          ],
          "description": "UiPath compatibility for Connect/Export. Windows (default) runs on Windows robots with classic UI selectors. Portable is cross-platform."
        },
        "lowcodeStudio.defaultWorkflowType": {
          "type": "string",
          "default": "Sequence",
          "enum": [
            "Sequence",
            "Flowchart"
          ],
          "description": "Default workflow type for new workflows."
        },
        "lowcodeStudio.autoOpenDesigner": {
          "type": "boolean",
          "default": true,
          "description": "Open the visual designer when creating a new workflow."
        },
        "lowcodeStudio.showLineNumbers": {
          "type": "boolean",
          "default": true,
          "description": "Show step numbers on the designer canvas."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "compile": "tsc -p ./",
    "bundle": "npm run compile && node esbuild.js",
    "watch": "tsc -watch -p ./",
    "package": "npm run bundle && vsce package --no-dependencies",
    "lint": "tsc --noEmit",
    "docs:activities": "npm run compile && node scripts/generate-activities-md.js",
    "test": "npm run compile && node out/test/simulator.test.js && node out/test/reframework.test.js && node out/test/xamlImport.test.js && node out/test/selectorRoundTrip.test.js && node out/test/pythonActivities.test.js && node out/test/customActivities.test.js && node out/test/refDryRun.test.js && node out/test/topActivities.test.js && node out/test/configBridge.test.js && node out/test/studioWebConnect.test.js && node out/test/packageValidation.test.js && node out/test/windowsTarget.test.js && npm run docs:activities"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@types/xlsx": "^0.0.35",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.28.1",
    "typescript": "^5.6.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nikosrokos/lowcode-studio"
  },
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.6.0",
    "fast-xml-parser": "^5.10.1",
    "xlsx": "^0.18.5"
  }
}
