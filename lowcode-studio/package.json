{
  "name": "lowcode-studio",
  "displayName": "LowCode Studio",
  "description": "Mac-first low-code RPA for VS Code/Cursor: REFramework design, scenario dry-runs (Shift+F5), and the easiest Connect to Studio Web handoff for Orchestrator publish.",
  "version": "0.6.6",
  "publisher": "lowcode-studio",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "rpa",
    "low-code",
    "automation",
    "studio",
    "workflow",
    "uipath",
    "reframework",
    "flowchart",
    "mac"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "icon": "media/icon.png",
  "contributes": {
    "customEditors": [
      {
        "viewType": "lowcodeStudio.workflowEditor",
        "displayName": "LowCode Studio Designer",
        "selector": [
          {
            "filenamePattern": "*.lcs.json"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lowcodeStudio",
          "title": "LowCode Studio",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "lowcodeStudio": [
        {
          "id": "lowcodeStudio.projects",
          "name": "Project Explorer"
        },
        {
          "id": "lowcodeStudio.activities",
          "name": "Activities"
        },
        {
          "id": "lowcodeStudio.variables",
          "name": "Variables"
        }
      ]
    },
    "commands": [
      {
        "command": "lowcodeStudio.openLocalProject",
        "title": "Open Local Project \u2014 browse for a folder with project.json",
        "icon": "$(folder-opened)",
        "shortTitle": "Open",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.newProject",
        "title": "New blank LowCode Studio project",
        "icon": "$(new-folder)",
        "shortTitle": "New",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.newREFramework",
        "title": "New REFramework Project \u2014 Init \u2192 Get Data \u2192 Process template",
        "icon": "$(type-hierarchy)",
        "shortTitle": "REFramework",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.newWorkflow",
        "title": "New Workflow \u2014 Sequence or Flowchart",
        "icon": "$(new-file)",
        "shortTitle": "Workflow",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.openDesigner",
        "title": "LowCode Studio: Open Designer"
      },
      {
        "command": "lowcodeStudio.validatePackages",
        "title": "Validate Packages \u2014 NuGet deps and Windows selector warnings",
        "icon": "$(warning)",
        "shortTitle": "Validate",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.validateWorkflow",
        "title": "Validate Workflow \u2014 required fields and structure",
        "icon": "$(check)",
        "shortTitle": "Validate",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.dryRun",
        "title": "Dry Run \u2014 simulate the open workflow (F5)",
        "icon": "$(play)",
        "shortTitle": "Dry Run",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.dryRunScenario",
        "title": "Dry Run Scenarios \u2014 run REFramework test scenarios (Shift+F5)",
        "icon": "$(beaker)",
        "shortTitle": "Scenarios",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.manageScenarios",
        "title": "Manage Scenarios \u2014 add, duplicate, or open scenarios.json",
        "icon": "$(checklist)",
        "shortTitle": "Manage",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.registerCustomActivity",
        "title": "Register a custom activity",
        "icon": "$(extensions)",
        "shortTitle": "Register",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.manageCustomActivities",
        "title": "Manage custom activities",
        "shortTitle": "Manage",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.addVariable",
        "title": "Add Variable to the open workflow",
        "icon": "$(add)",
        "shortTitle": "Add",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.refreshExplorer",
        "title": "Refresh Project Explorer",
        "icon": "$(refresh)",
        "shortTitle": "Refresh",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.insertActivity",
        "title": "LowCode Studio: Insert Activity"
      },
      {
        "command": "lowcodeStudio.exportPseudocode",
        "title": "LowCode Studio: Export Pseudocode"
      },
      {
        "command": "lowcodeStudio.importUiPathProject",
        "title": "Import UiPath Project Folder into LowCode Studio",
        "icon": "$(folder-opened)",
        "shortTitle": "Import Folder",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.importUiPathPackage",
        "title": "Import UiPath Package (.nupkg)",
        "icon": "$(file-zip)",
        "shortTitle": "Import .nupkg",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.connectStudioWeb",
        "title": "Connect to Studio Web \u2014 export Windows .uip / .uis for publish",
        "icon": "$(cloud-upload)",
        "shortTitle": "Connect",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.exportStudioWeb",
        "title": "Export for Studio Web (Windows project folder)",
        "icon": "$(export)",
        "shortTitle": "Export",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.showStudioWebGuide",
        "title": "LowCode Studio: Show Studio Web Guide"
      },
      {
        "command": "lowcodeStudio.exportConfigXlsx",
        "title": "Export Config.xlsx from Config.json",
        "icon": "$(file-binary)",
        "shortTitle": "Export Config",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.importConfigXlsx",
        "title": "Import Config.xlsx into Config.json",
        "icon": "$(file)",
        "shortTitle": "Import Config",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.openStudioWeb",
        "title": "LowCode Studio: Open Studio Web"
      },
      {
        "command": "lowcodeStudio.showGettingStarted",
        "title": "LowCode Studio: Getting Started"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "lowcodeStudio.openLocalProject",
          "when": "view == lowcodeStudio.projects",
          "group": "navigation@0",
          "tooltip": "Open Local Project \u2014 browse for a folder with project.json"
        },
        {
          "command": "lowcodeStudio.dryRunScenario",
          "when": "view == lowcodeStudio.projects",
          "group": "navigation@1",
          "tooltip": "Dry Run Scenarios \u2014 run REFramework test scenarios (Shift+F5)"
        },
        {
          "command": "lowcodeStudio.manageScenarios",
          "when": "view == lowcodeStudio.projects",
          "group": "navigation@2",
          "tooltip": "Manage Scenarios \u2014 add, duplicate, or open scenarios.json"
        },
        {
          "command": "lowcodeStudio.connectStudioWeb",
          "when": "view == lowcodeStudio.projects",
          "group": "navigation@3",
          "tooltip": "Connect to Studio Web \u2014 export Windows .uip / .uis for publish"
        },
        {
          "command": "lowcodeStudio.validatePackages",
          "when": "view == lowcodeStudio.projects",
          "group": "navigation@4",
          "tooltip": "Validate Packages \u2014 NuGet deps and Windows selector warnings"
        },
        {
          "command": "lowcodeStudio.refreshExplorer",
          "when": "view == lowcodeStudio.projects",
          "group": "navigation@5",
          "tooltip": "Refresh Project Explorer"
        },
        {
          "command": "lowcodeStudio.newREFramework",
          "when": "view == lowcodeStudio.projects",
          "group": "1_create@1",
          "tooltip": "New REFramework Project \u2014 Init \u2192 Get Data \u2192 Process template"
        },
        {
          "command": "lowcodeStudio.newProject",
          "when": "view == lowcodeStudio.projects",
          "group": "1_create@2",
          "tooltip": "New blank LowCode Studio project"
        },
        {
          "command": "lowcodeStudio.newWorkflow",
          "when": "view == lowcodeStudio.projects",
          "group": "1_create@3",
          "tooltip": "New Workflow \u2014 Sequence or Flowchart"
        },
        {
          "command": "lowcodeStudio.importUiPathProject",
          "when": "view == lowcodeStudio.projects",
          "group": "2_import@1",
          "tooltip": "Import UiPath Project Folder into LowCode Studio"
        },
        {
          "command": "lowcodeStudio.importUiPathPackage",
          "when": "view == lowcodeStudio.projects",
          "group": "2_import@2",
          "tooltip": "Import UiPath Package (.nupkg)"
        },
        {
          "command": "lowcodeStudio.exportStudioWeb",
          "when": "view == lowcodeStudio.projects",
          "group": "3_export@1",
          "tooltip": "Export for Studio Web (Windows project folder)"
        },
        {
          "command": "lowcodeStudio.exportConfigXlsx",
          "when": "view == lowcodeStudio.projects",
          "group": "3_export@2",
          "tooltip": "Export Config.xlsx from Config.json"
        },
        {
          "command": "lowcodeStudio.importConfigXlsx",
          "when": "view == lowcodeStudio.projects",
          "group": "3_export@3",
          "tooltip": "Import Config.xlsx into Config.json"
        },
        {
          "command": "lowcodeStudio.addVariable",
          "when": "view == lowcodeStudio.variables",
          "group": "navigation",
          "tooltip": "Add Variable to the open workflow"
        },
        {
          "command": "lowcodeStudio.registerCustomActivity",
          "when": "view == lowcodeStudio.activities",
          "group": "navigation",
          "tooltip": "Register a custom activity"
        },
        {
          "command": "lowcodeStudio.manageCustomActivities",
          "when": "view == lowcodeStudio.activities",
          "group": "navigation",
          "tooltip": "Manage custom activities"
        }
      ],
      "view/item/context": [
        {
          "command": "lowcodeStudio.insertActivity",
          "when": "view == lowcodeStudio.activities && viewItem == activity",
          "group": "inline"
        }
      ],
      "editor/title": [
        {
          "command": "lowcodeStudio.validatePackages",
          "when": "resourceFilename =~ /\\.lcs\\.json$/",
          "group": "navigation"
        },
        {
          "command": "lowcodeStudio.validateWorkflow",
          "when": "resourceFilename =~ /\\.lcs\\.json$/",
          "group": "navigation"
        },
        {
          "command": "lowcodeStudio.dryRun",
          "when": "resourceFilename =~ /\\.lcs\\.json$/",
          "group": "navigation"
        },
        {
          "command": "lowcodeStudio.dryRunScenario",
          "when": "resourceFilename =~ /\\.lcs\\.json$/",
          "group": "navigation"
        },
        {
          "command": "lowcodeStudio.connectStudioWeb",
          "when": "resourceFilename =~ /\\.lcs\\.json$/",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "lowcodeStudio.insertActivity",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "lowcodeStudio.newWorkflow",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      },
      {
        "command": "lowcodeStudio.dryRun",
        "key": "f5",
        "when": "resourceFilename =~ /\\.lcs\\.json$/"
      },
      {
        "command": "lowcodeStudio.dryRunScenario",
        "key": "shift+f5",
        "when": "resourceFilename =~ /\\.lcs\\.json$/"
      },
      {
        "command": "lowcodeStudio.manageScenarios",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t"
      },
      {
        "command": "lowcodeStudio.connectStudioWeb",
        "key": "ctrl+shift+u",
        "mac": "cmd+shift+u"
      },
      {
        "command": "lowcodeStudio.validateWorkflow",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "resourceFilename =~ /\\.lcs\\.json$/"
      }
    ],
    "languages": [
      {
        "id": "lowcode-studio",
        "aliases": [
          "LowCode Studio Workflow",
          "lcs"
        ],
        "extensions": [
          ".lcs.json"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "*.lcs.json",
        "url": "./schemas/workflow.schema.json"
      }
    ],
    "configuration": {
      "title": "LowCode Studio",
      "properties": {
        "lowcodeStudio.uipathTargetFramework": {
          "type": "string",
          "default": "Windows",
          "enum": [
            "Windows",
            "Portable"
          ],
          "description": "UiPath compatibility for Connect/Export. Windows (default) runs on Windows robots with classic UI selectors. Portable is cross-platform."
        },
        "lowcodeStudio.defaultWorkflowType": {
          "type": "string",
          "default": "Sequence",
          "enum": [
            "Sequence",
            "Flowchart"
          ],
          "description": "Default workflow type for new workflows."
        },
        "lowcodeStudio.autoOpenDesigner": {
          "type": "boolean",
          "default": true,
          "description": "Open the visual designer when creating a new workflow."
        },
        "lowcodeStudio.showLineNumbers": {
          "type": "boolean",
          "default": true,
          "description": "Show step numbers on the designer canvas."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "compile": "tsc -p ./",
    "bundle": "npm run compile && node esbuild.js",
    "watch": "tsc -watch -p ./",
    "package": "npm run bundle && vsce package --no-dependencies",
    "lint": "tsc --noEmit",
    "docs:activities": "npm run compile && node scripts/generate-activities-md.js",
    "test": "npm run compile && node out/test/simulator.test.js && node out/test/reframework.test.js && node out/test/xamlImport.test.js && node out/test/selectorRoundTrip.test.js && node out/test/pythonActivities.test.js && node out/test/customActivities.test.js && node out/test/refDryRun.test.js && node out/test/topActivities.test.js && node out/test/configBridge.test.js && node out/test/studioWebConnect.test.js && node out/test/packageValidation.test.js && node out/test/windowsTarget.test.js && node out/test/extractTableData.test.js && node out/test/selectorBuilder.test.js && node out/test/windowsTodo.test.js && node out/test/strongDryRun.test.js && npm run docs:activities"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@types/xlsx": "^0.0.35",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.28.1",
    "typescript": "^5.6.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nikosrokos/lowcode-studio"
  },
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.6.0",
    "fast-xml-parser": "^5.10.1",
    "xlsx": "^0.18.5"
  }
}
