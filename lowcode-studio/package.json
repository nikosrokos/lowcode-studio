{
  "name": "lowcode-studio",
  "displayName": "LowCode Studio",
  "description": "Mac-first low-code RPA for VS Code/Cursor: REFramework design, scenario dry-runs (Shift+F5), and the easiest Connect to Studio Web handoff for Orchestrator publish.",
  "version": "0.6.51",
  "publisher": "lowcode-studio",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "rpa",
    "low-code",
    "automation",
    "studio",
    "workflow",
    "uipath",
    "reframework",
    "flowchart",
    "mac"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "icon": "media/icon.png",
  "contributes": {
    "customEditors": [
      {
        "viewType": "lowcodeStudio.workflowEditor",
        "displayName": "LowCode Studio Designer",
        "selector": [
          {
            "filenamePattern": "*.lcs.json"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lowcodeStudio",
          "title": "LowCode Studio",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "lowcodeStudio": [
        {
          "id": "lowcodeStudio.home",
          "name": "Home",
          "type": "webview"
        },
        {
          "id": "lowcodeStudio.projects",
          "name": "Project Explorer"
        },
        {
          "id": "lowcodeStudio.variables",
          "name": "Variables"
        },
        {
          "id": "lowcodeStudio.activities",
          "name": "Activities"
        }
      ]
    },
    "commands": [
      {
        "command": "lowcodeStudio.openLocalProject",
        "title": "Open Local Project — LCS project or Studio Web solution (.uipx)",
        "icon": "$(folder-opened)",
        "shortTitle": "Open",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.newProject",
        "title": "New blank LowCode Studio project",
        "icon": "$(new-folder)",
        "shortTitle": "New",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.newREFramework",
        "title": "New REFramework Project — Init → Get Data → Process template",
        "icon": "$(type-hierarchy)",
        "shortTitle": "REFramework",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.newBlueprint",
        "title": "New Robot Blueprint — scrape→Excel, login→email, API→table",
        "icon": "$(symbol-misc)",
        "shortTitle": "Blueprint",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.newWorkflow",
        "title": "New Workflow — Sequence or Flowchart",
        "icon": "$(new-file)",
        "shortTitle": "Workflow",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.openDesigner",
        "title": "LowCode Studio: Open Designer"
      },
      {
        "command": "lowcodeStudio.validatePackages",
        "title": "Validate Packages — NuGet deps and Windows selector warnings",
        "icon": "$(warning)",
        "shortTitle": "Validate",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.validateWorkflow",
        "title": "Validate Workflow — required fields and structure",
        "icon": "$(check)",
        "shortTitle": "Validate",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.dryRun",
        "title": "Dry Run — simulate the open workflow (F5)",
        "icon": "$(play)",
        "shortTitle": "Dry Run",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.dryRunScenario",
        "title": "Dry Run Scenarios — run REFramework test scenarios (Shift+F5)",
        "icon": "$(beaker)",
        "shortTitle": "Scenarios",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.manageScenarios",
        "title": "Manage Scenarios — add, duplicate, or open scenarios.json",
        "icon": "$(checklist)",
        "shortTitle": "Manage",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.registerCustomActivity",
        "title": "Register a custom activity",
        "icon": "$(extensions)",
        "shortTitle": "Register",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.manageCustomActivities",
        "title": "Manage custom activities",
        "shortTitle": "Manage",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.addVariable",
        "title": "Add Variable to the open workflow",
        "icon": "$(add)",
        "shortTitle": "Add",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.refreshExplorer",
        "title": "Refresh Project Explorer",
        "icon": "$(refresh)",
        "shortTitle": "Refresh",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.insertActivity",
        "title": "Insert Activity — Cmd+K palette (favorites + recent)",
        "shortTitle": "Insert",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.activityPalette",
        "title": "Activity Palette — search, favorites, recent (Cmd+K in designer)",
        "icon": "$(search)",
        "shortTitle": "Palette",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.exportPseudocode",
        "title": "LowCode Studio: Export Pseudocode"
      },
      {
        "command": "lowcodeStudio.importUiPathProject",
        "title": "Import UiPath Project Folder into LowCode Studio",
        "icon": "$(folder-opened)",
        "shortTitle": "Import Folder",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.importUiPathPackage",
        "title": "Import UiPath Package (.nupkg)",
        "icon": "$(file-zip)",
        "shortTitle": "Import .nupkg",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.connectStudioWeb",
        "title": "Connect / Open Studio Web Local Workspace (sync on Save)",
        "icon": "$(cloud-upload)",
        "shortTitle": "Studio Web",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.setActiveProject",
        "title": "Set Active Project",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.removeFromExplorer",
        "title": "Remove from Project Explorer",
        "icon": "$(close)",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.unlinkStudioWebLocal",
        "title": "Unlink Studio Web Local Workspace",
        "icon": "$(debug-disconnect)",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.pullStudioWebLocal",
        "title": "Pull from Studio Web Local Workspace",
        "icon": "$(cloud-download)",
        "shortTitle": "Pull Studio Web",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.exportStudioWeb",
        "title": "Export for Studio Web (Windows project folder)",
        "icon": "$(export)",
        "shortTitle": "Export",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.showStudioWebGuide",
        "title": "LowCode Studio: Show Studio Web Guide"
      },
      {
        "command": "lowcodeStudio.exportConfigXlsx",
        "title": "Export Config.xlsx from Config.json",
        "icon": "$(file-binary)",
        "shortTitle": "Export Config",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.importConfigXlsx",
        "title": "Import Config.xlsx into Config.json",
        "icon": "$(file)",
        "shortTitle": "Import Config",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.openStudioWeb",
        "title": "LowCode Studio: Open Studio Web"
      },
      {
        "command": "lowcodeStudio.showGettingStarted",
        "title": "LowCode Studio: Getting Started"
      },
      {
        "command": "lowcodeStudio.openHome",
        "title": "Open Home Screen",
        "icon": "$(home)",
        "shortTitle": "Home",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.openHomePanel",
        "title": "Open Home Screen (editor tab)",
        "icon": "$(home)",
        "shortTitle": "Home tab",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.showWhatsNew",
        "title": "What's New (changelog)",
        "shortTitle": "What's New",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.managePackages",
        "title": "Manage Packages (NuGet pins)",
        "icon": "$(package)",
        "shortTitle": "Packages",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.firstRunWizard",
        "title": "First-run wizard (REF → Scenario → Connect)",
        "icon": "$(rocket)",
        "shortTitle": "Wizard",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.explainWorkflow",
        "title": "Explain / critique workflow (Assist)",
        "icon": "$(info)",
        "shortTitle": "Explain",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.generateScenarios",
        "title": "Generate scenarios from description (Assist)",
        "icon": "$(sparkle)",
        "shortTitle": "Gen scenarios",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.suggestSelectors",
        "title": "Suggest / repair selectors (Assist)",
        "icon": "$(inspect)",
        "shortTitle": "Selectors",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.repairExpressions",
        "title": "Repair VB expressions (Assist)",
        "icon": "$(symbol-operator)",
        "shortTitle": "VB repair",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.scaffoldFromDescription",
        "title": "Scaffold sequence from description (Assist)",
        "icon": "$(sparkle)",
        "shortTitle": "Scaffold",
        "category": "LowCode Studio"
      },
      {
        "command": "lowcodeStudio.repairFromDryRunTrace",
        "title": "Repair from dry-run trace (Assist)",
        "icon": "$(debug-alt)",
        "shortTitle": "Trace repair",
        "category": "LowCode Studio"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "lowcodeStudio.openHomePanel",
          "when": "view == lowcodeStudio.home",
          "group": "navigation@0",
          "tooltip": "Open Home as a full editor tab"
        },
        {
          "command": "lowcodeStudio.openHome",
          "when": "view == lowcodeStudio.home",
          "group": "navigation@0",
          "tooltip": "Focus Home in the sidebar"
        },
        {
          "command": "lowcodeStudio.openLocalProject",
          "when": "view == lowcodeStudio.home",
          "group": "navigation@1",
          "tooltip": "Open Local Project — LCS project or Studio Web solution (.uipx)"
        },
        {
          "command": "lowcodeStudio.openLocalProject",
          "when": "view == lowcodeStudio.projects",
          "group": "navigation@0",
          "tooltip": "Open Local Project — LCS project or Studio Web solution (.uipx)"
        },
        {
          "command": "lowcodeStudio.dryRunScenario",
          "when": "view == lowcodeStudio.projects",
          "group": "navigation@1",
          "tooltip": "Dry Run Scenarios — run REFramework test scenarios (Shift+F5)"
        },
        {
          "command": "lowcodeStudio.manageScenarios",
          "when": "view == lowcodeStudio.projects",
          "group": "navigation@2",
          "tooltip": "Manage Scenarios — add, duplicate, or open scenarios.json"
        },
        {
          "command": "lowcodeStudio.connectStudioWeb",
          "when": "view == lowcodeStudio.projects",
          "group": "navigation@3",
          "tooltip": "Open/create Studio Web Local Workspace — Save syncs .xaml"
        },
        {
          "command": "lowcodeStudio.validatePackages",
          "when": "view == lowcodeStudio.projects",
          "group": "navigation@4",
          "tooltip": "Validate Packages — NuGet deps and Windows selector warnings"
        },
        {
          "command": "lowcodeStudio.refreshExplorer",
          "when": "view == lowcodeStudio.projects",
          "group": "navigation@5",
          "tooltip": "Refresh Project Explorer"
        },
        {
          "command": "lowcodeStudio.newBlueprint",
          "when": "view == lowcodeStudio.projects",
          "group": "1_create@1",
          "tooltip": "New Robot Blueprint — scrape→Excel, login→email, API→table"
        },
        {
          "command": "lowcodeStudio.newREFramework",
          "when": "view == lowcodeStudio.projects",
          "group": "1_create@2",
          "tooltip": "New REFramework Project — Init → Get Data → Process template"
        },
        {
          "command": "lowcodeStudio.newProject",
          "when": "view == lowcodeStudio.projects",
          "group": "1_create@3",
          "tooltip": "New blank LowCode Studio project"
        },
        {
          "command": "lowcodeStudio.newWorkflow",
          "when": "view == lowcodeStudio.projects",
          "group": "1_create@4",
          "tooltip": "New Workflow — Sequence or Flowchart"
        },
        {
          "command": "lowcodeStudio.importUiPathProject",
          "when": "view == lowcodeStudio.projects",
          "group": "2_import@1",
          "tooltip": "Import UiPath Project Folder into LowCode Studio"
        },
        {
          "command": "lowcodeStudio.importUiPathPackage",
          "when": "view == lowcodeStudio.projects",
          "group": "2_import@2",
          "tooltip": "Import UiPath Package (.nupkg)"
        },
        {
          "command": "lowcodeStudio.exportStudioWeb",
          "when": "view == lowcodeStudio.projects",
          "group": "3_export@1",
          "tooltip": "Export for Studio Web (Windows project folder)"
        },
        {
          "command": "lowcodeStudio.exportConfigXlsx",
          "when": "view == lowcodeStudio.projects",
          "group": "3_export@2",
          "tooltip": "Export Config.xlsx from Config.json"
        },
        {
          "command": "lowcodeStudio.importConfigXlsx",
          "when": "view == lowcodeStudio.projects",
          "group": "3_export@3",
          "tooltip": "Import Config.xlsx into Config.json"
        },
        {
          "command": "lowcodeStudio.addVariable",
          "when": "view == lowcodeStudio.variables",
          "group": "navigation",
          "tooltip": "Add Variable to the open workflow"
        },
        {
          "command": "lowcodeStudio.registerCustomActivity",
          "when": "view == lowcodeStudio.activities",
          "group": "navigation",
          "tooltip": "Register a custom activity"
        },
        {
          "command": "lowcodeStudio.manageCustomActivities",
          "when": "view == lowcodeStudio.activities",
          "group": "navigation",
          "tooltip": "Manage custom activities"
        },
        {
          "command": "lowcodeStudio.managePackages",
          "when": "view == lowcodeStudio.projects",
          "group": "navigation@4"
        },
        {
          "command": "lowcodeStudio.explainWorkflow",
          "when": "view == lowcodeStudio.projects",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "lowcodeStudio.insertActivity",
          "when": "view == lowcodeStudio.activities && viewItem == activity",
          "group": "inline"
        },
        {
          "command": "lowcodeStudio.removeFromExplorer",
          "when": "view == lowcodeStudio.projects && (viewItem == project || viewItem == solution)",
          "group": "inline@1"
        },
        {
          "command": "lowcodeStudio.removeFromExplorer",
          "when": "view == lowcodeStudio.projects && (viewItem == project || viewItem == solution)",
          "group": "1_modify@1"
        },
        {
          "command": "lowcodeStudio.unlinkStudioWebLocal",
          "when": "view == lowcodeStudio.projects && (viewItem == project || viewItem == solution)",
          "group": "1_modify@2"
        },
        {
          "command": "lowcodeStudio.pullStudioWebLocal",
          "when": "view == lowcodeStudio.projects && viewItem == project",
          "group": "1_modify@1"
        }
      ],
      "editor/title": [
        {
          "command": "lowcodeStudio.activityPalette",
          "when": "resourceFilename =~ /\\.lcs\\.json$/",
          "group": "navigation@0"
        },
        {
          "command": "lowcodeStudio.validatePackages",
          "when": "resourceFilename =~ /\\.lcs\\.json$/",
          "group": "navigation"
        },
        {
          "command": "lowcodeStudio.validateWorkflow",
          "when": "resourceFilename =~ /\\.lcs\\.json$/",
          "group": "navigation"
        },
        {
          "command": "lowcodeStudio.dryRun",
          "when": "resourceFilename =~ /\\.lcs\\.json$/",
          "group": "navigation"
        },
        {
          "command": "lowcodeStudio.dryRunScenario",
          "when": "resourceFilename =~ /\\.lcs\\.json$/",
          "group": "navigation"
        },
        {
          "command": "lowcodeStudio.explainWorkflow",
          "when": "resourceFilename =~ /\\.lcs\\.json$/",
          "group": "navigation"
        },
        {
          "command": "lowcodeStudio.suggestSelectors",
          "when": "resourceFilename =~ /\\.lcs\\.json$/",
          "group": "navigation"
        },
        {
          "command": "lowcodeStudio.repairExpressions",
          "when": "resourceFilename =~ /\\.lcs\\.json$/",
          "group": "navigation"
        },
        {
          "command": "lowcodeStudio.connectStudioWeb",
          "when": "resourceFilename =~ /\\.lcs\\.json$/",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "lowcodeStudio.activityPalette",
        "key": "ctrl+k ctrl+i",
        "mac": "cmd+k cmd+i",
        "when": "resourceFilename =~ /\\.lcs\\.json$/"
      },
      {
        "command": "lowcodeStudio.activityPalette",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a",
        "when": "resourceFilename =~ /\\.lcs\\.json$/"
      },
      {
        "command": "lowcodeStudio.newWorkflow",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      },
      {
        "command": "lowcodeStudio.dryRun",
        "key": "f5",
        "when": "resourceFilename =~ /\\.lcs\\.json$/"
      },
      {
        "command": "lowcodeStudio.dryRunScenario",
        "key": "shift+f5",
        "when": "resourceFilename =~ /\\.lcs\\.json$/"
      },
      {
        "command": "lowcodeStudio.manageScenarios",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t"
      },
      {
        "command": "lowcodeStudio.connectStudioWeb",
        "key": "ctrl+shift+u",
        "mac": "cmd+shift+u"
      },
      {
        "command": "lowcodeStudio.validateWorkflow",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "resourceFilename =~ /\\.lcs\\.json$/"
      }
    ],
    "languages": [
      {
        "id": "lowcode-studio",
        "aliases": [
          "LowCode Studio Workflow",
          "lcs"
        ],
        "extensions": [
          ".lcs.json"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "*.lcs.json",
        "url": "./schemas/workflow.schema.json"
      }
    ],
    "configuration": {
      "title": "LowCode Studio",
      "properties": {
        "lowcodeStudio.uipathTargetFramework": {
          "type": "string",
          "default": "Windows",
          "enum": [
            "Windows",
            "Portable"
          ],
          "description": "UiPath compatibility for Connect/Export. Windows (default) runs on Windows robots with classic UI selectors. Portable is cross-platform."
        },
        "lowcodeStudio.defaultWorkflowType": {
          "type": "string",
          "default": "Sequence",
          "enum": [
            "Sequence",
            "Flowchart"
          ],
          "description": "Default workflow type for new workflows."
        },
        "lowcodeStudio.autoOpenDesigner": {
          "type": "boolean",
          "default": true,
          "description": "Open the visual designer when creating a new workflow."
        },
        "lowcodeStudio.showLineNumbers": {
          "type": "boolean",
          "default": true,
          "description": "Show step numbers on the designer canvas."
        },
        "lowcodeStudio.canvasStyle": {
          "type": "string",
          "default": "plain",
          "enum": [
            "plain",
            "dots"
          ],
          "description": "Designer canvas background: plain board or subtle dot grid."
        },
        "lowcodeStudio.showCardSummaries": {
          "type": "boolean",
          "default": true,
          "description": "Show one-line property summaries under activity titles on the canvas."
        },
        "lowcodeStudio.compactCards": {
          "type": "boolean",
          "default": false,
          "description": "Use tighter padding on sequence activity cards."
        },
        "lowcodeStudio.showConnectors": {
          "type": "boolean",
          "default": true,
          "description": "Show spine connectors between sequence steps."
        },
        "lowcodeStudio.defaultZoom": {
          "type": "number",
          "default": 1,
          "enum": [
            0.75,
            1,
            1.25
          ],
          "description": "Default designer zoom when opening a workflow (75%, 100%, or 125%)."
        },
        "lowcodeStudio.openHomeOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Focus the LowCode Studio Home view on activation and when clicking the activity-bar icon (container was hidden)."
        },
        "lowcodeStudio.syncStudioWebOnSave": {
          "type": "boolean",
          "default": true,
          "description": "When linked to Studio Web Local Workspace: on Save, pull Studio Web .xaml edits into .lcs.json (when LCS unchanged), then push .xaml. Overwrites land in .lcs-sync-trash/."
        },
        "lowcodeStudio.dryRun.realHttp": {
          "type": "boolean",
          "default": false,
          "description": "Opt-in: perform real HTTP requests during dry-run for Messaging.HttpRequest (host must be on the allow list). Fixtures always win."
        },
        "lowcodeStudio.dryRun.httpAllowHosts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Hostnames allowed for real HTTP dry-run (exact or parent domain). Empty = no real HTTP."
        },
        "lowcodeStudio.dryRun.httpTimeoutMs": {
          "type": "number",
          "default": 10000,
          "description": "Timeout in ms for real HTTP dry-run requests."
        },
        "lowcodeStudio.dryRun.realPython": {
          "type": "boolean",
          "default": false,
          "description": "Opt-in: run Python.LoadScript / RunScript with a local interpreter when Python Scope path is set."
        },
        "lowcodeStudio.dryRun.pythonTimeoutMs": {
          "type": "number",
          "default": 15000,
          "description": "Timeout in ms for real Python dry-run."
        }
      }
    },
    "configurationDefaults": {
      "files.exclude": {
        "**/.lcs-sync-trash": true
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "compile": "tsc -p ./",
    "bundle": "npm run compile && node esbuild.js",
    "watch": "tsc -watch -p ./",
    "package": "npm run bundle && vsce package --no-dependencies",
    "lint": "tsc --noEmit",
    "docs:activities": "npm run compile && node scripts/generate-activities-md.js",
